    "faq:validate": "node scripts/validate-faq.js",
    "faq:refine": "node faq_tools.js refine",
    "faq:merge": "node faq_tools.js merge",
    "faq:apply-fixes": "node faq_tools.js apply-fixes",
    "score": "node score_answers.js"
  },
  "keywords": [
    "chemistry",
    "education",
    "rag",
    "llm",
    "deepseek",
    "coordination-chemistry"
  ],
