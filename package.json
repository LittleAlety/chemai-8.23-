    "pipeline:quick": "node run_pipeline.js --mode quick --cycles 10",
    "pipeline:full": "node run_pipeline.js --mode full --cycles 30",
    "pipeline:single": "node run_pipeline.js --mode single",
    "faq:stats": "node faq_tools.js stats",
